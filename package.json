{
  "name": "gaveta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @gaveta/extension test",
    "test:e2e": "pnpm --filter @gaveta/extension test:e2e",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @gaveta/extension dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
